# Gerado automaticamente por `npm run setup`. Nunca commitar o .env.
PORT=3000
# Chave de 32 bytes (64 hex) que cifra as chaves de API no banco. Se perder, as chaves precisam ser recadastradas.
MASTER_KEY=
# 1 quando servido por HTTPS (cookies Secure + HSTS). Obrigatório em produção.
COOKIE_SECURE=0
# 1 quando atrás de proxy reverso (nginx, Cloudflare) para o IP real chegar ao rate limit.
TRUST_PROXY=0
# Sessões: inatividade (min) e duração máxima (h). Usuários "tv" têm sessão longa (30 dias).
SESSION_IDLE_MIN=240
SESSION_ABS_HOURS=24
# Intervalo da sincronização com Google/Meta (minutos)
SYNC_INTERVAL_MIN=15
# Versões das APIs
META_API_VERSION=v21.0
GOOGLE_ADS_API_VERSION=v25
